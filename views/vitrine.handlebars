<!DOCTYPE html>  
<html lang="pt-BR">  
<head>  
 <meta charset="UTF-8">  
 <meta name="viewport" content="width=device-width, initial-scale=1.0">  
 <title>Vitrine de Produtos</title>  
</head>  
<style>  
 body {  
   margin: 0;   
   padding: 0;  
   background-color: #f4f4f4;   
   font-family: sans-serif;  
 }  
  
 .faixa-azul {  
   background-color: #0b00a0;   
   width: 100%;  
   height: 70px;  
   box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.4);   
   display: flex;  
   align-items: center;  
   justify-content: space-between;
   padding: 0 30px;  
   box-sizing: border-box;  
 }  

 /* H1 visível e estilizado na barra principal para aprovação no Silktide */
 .titulo-principal {
   color: #ffffff;
   font-size: 1.5rem;
   margin: 0;
   font-weight: bold;
 }

 .voltar-cadastro {  
   color: #ffffff;  
   background-color: #000080;
   text-decoration: none;   
   font-weight: bold;  
   font-size: 0.95rem;  
   border: 2px solid #ffffff;   
   padding: 10px 20px;  
   border-radius: 50px;   
 }  

 .voltar-cadastro:hover {
   background-color: #ffffff;
   color: #0b00a0;
 }

 .barra-busca {  
   display: flex;  
   justify-content: center;  
   padding: 30px 20px 0 20px;  
 }  
  
 .busca-form {  
   display: flex;  
   gap: 10px;  
 }  
  
 .busca-item {  
   width: 400px;   
   padding: 12px 20px;  
   border-radius: 50px;  
   border: 2px solid #000080;   
   outline: none;  
   box-shadow: 0px 4px 10px rgba(0,0,0,0.1);   
   font-size: 1rem;  
   background-color: #ffffff; 
   color: #000000;  
 }  
  
 .btn-busca {  
   background-color: #0b00a0;  
   color: #ffffff;  
   border: none;  
   padding: 10px 25px;  
   border-radius: 50px;  
   font-weight: bold;  
   cursor: pointer;  
   box-shadow: 0px 4px 8px rgba(0,0,0,0.2);  
 }  
   
 .vitrine-container {  
   display: flex;  
   flex-wrap: wrap;   
   gap: 25px;   
   padding: 30px;  
   justify-content: flex-start;   
 }  
  
 .card-item {  
   background-color: #ffffff;   
   width: 280px;   
   border-radius: 8px;   
   box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);   
   overflow: hidden;  
   display: flex;  
   flex-direction: column;  
   transition: transform 0.3s ease, box-shadow 0.3s ease;   
 }  
  
 .card-item:hover {  
   transform: translateY(-5px);  
   box-shadow: 0 8px 15px rgba(0, 0, 0, 0.2);  
 }  
  
 .card-imagem img {  
   width: 100%;  
   height: 180px;  
   object-fit: cover;   
   border-bottom: 3px solid #000080;   
 }  
  
 .card-info {  
   padding: 20px;  
   display: flex;  
   flex-direction: column;  
   flex-grow: 1;   
 }  
  
 .card-titulo {  
   margin: 0 0 10px 0;  
   color: #000000;  
   font-size: 1.2rem;  
   font-family: sans-serif;  
 }  
  
 .card-categoria {  
   background-color: #d1e3ff;  
   color: #002266;  
   font-size: 0.85rem;  
   font-weight: bold;
   padding: 4px 8px;  
   border-radius: 4px;  
   align-self: flex-start;   
   margin-bottom: 12px;  
   font-family: sans-serif;  
 }  
  
 .card-descricao {  
   color: #111111;  
   font-size: 0.9rem;  
   margin-bottom: 20px;  
   line-height: 1.4;  
   flex-grow: 1;  
   font-family: sans-serif;  
 }  
  
 .card-rodape {  
   display: flex;  
   justify-content: space-between;   
   align-items: center;  
   border-top: 1px solid #cccccc;   
   padding-top: 15px;  
   font-family: sans-serif;  
 }  
  
 .card-preco {  
   color: #000080;   
   font-weight: bold;  
   font-size: 1.1rem;  
 }  
  
 .card-estoque {  
   color: #222222;  
   font-weight: bold;
   font-size: 0.85rem;  
 }  
  
 .mensagem-vazia {  
   text-align: center;  
   color: #000000;  
   font-weight: bold;
   font-size: 1.2rem;  
   margin-top: 50px;  
 }  
  
 .btn-acao {  
   width: 100%;  
   background-color: #b30000; 
   color: #ffffff;  
   border: none;  
   padding: 8px;   
   border-radius: 4px;   
   font-size: 0.9rem;  
   font-weight: bold;
   cursor: pointer;  
 }  
  
 .card-acao {  
   display: flex;  
   gap: 10px;  
   margin-top: 15px;  
 }  

 .card-acao a {  
   flex: 1;  
   text-align: center;  
   background-color: #0b00a0; 
   color: #ffffff;  
   padding: 8px;  
   text-decoration: none;  
   border-radius: 4px;  
   font-size: 0.9rem;  
   font-weight: bold;
 }  
</style>  
<body>  
 <header class="faixa-azul">  
   <!-- H1 Visível para corrigir o erro 'Heading text' -->
   <h1 class="titulo-principal">Vitrine de Produtos</h1>
   
   <!-- Link atualizado com aria-label e title para corrigir 'Links with different destinations' -->
   <a href="/cadastro" class="voltar-cadastro" aria-label="Navegar para a página de formulário para cadastrar novo item" title="Cadastrar Novo Item">Cadastrar Novo Item</a>  
 </header>  

 <div class="barra-busca">  
   <form action="/vitrine" method="GET" class="busca-form">  
     <input type="text" id="busca" name="busca" class="busca-item" placeholder="Qual item deseja buscar?" value="{{itemBuscado}}" aria-label="Qual item deseja buscar?">
     <button type="submit" class="btn-busca">Buscar</button>
   </form>  
 </div>  

 <div class="vitrine-container">  
   {{#each itens}}  
   <div class="card-item">  
     <div class="card-imagem">  
       <img src="{{this.imagem}}" alt="Imagem de {{this.nome}}">  
     </div>  
     
     <div class="card-info">  
       <h2 class="card-titulo">{{this.nome}}</h2>  
       <span class="card-categoria">{{this.categoria}}</span>  
       <p class="card-descricao">{{this.descricao}}</p>  
       
       <div class="card-rodape">  
         <span class="card-preco">{{this.preco}} Pontos</span>  
         <span class="card-estoque">Em Estoque: {{this.quantidade}}</span>  
       </div>  

       <div class="card-acao">  
         <a href="/editar/{{this.id}}" aria-label="Editar o produto {{this.nome}}" title="Editar o produto {{this.nome}}">Editar</a>  
         <form action="/deletar/{{this.id}}" method="POST" style="flex: 1;">  
           <button class="btn-acao" type="submit" aria-label="Deletar o produto {{this.nome}}" title="Deletar o produto {{this.nome}}">Deletar</button>
         </form>   
       </div>  
     </div>  
   </div>  
   {{else}}  
   <p class="mensagem-vazia">Nenhum item disponível no momento.</p>  
   {{/each}}  
 </div>  
</body>  
</html>